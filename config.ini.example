[pyrogram]
api_id =
api_hash =
bot_token =
admins =

[mongo]
# Use the Compose service name so container renames do not break DNS.
url = mongodb:27017
username = admin
password = password
db_name=firefly_sms_parser
auth_source = admin

[firefly]
url = https://firefly.your-domain.com
api_key = your_api_key
default_account_id = 1
request_timeout = 30
error_on_duplicate = true

[exchange_rates]
local_currency = MVR
USD = 15.42
EUR = 16.20

[ai]
# AI_PROVIDER=groq (default) or AI_PROVIDER=openrouter selects the backend.
# GROQ_API_KEY and GROQ_MODEL override these Groq settings.
groq_api_key =
model = qwen/qwen3.8-27b
# OPENROUTER_API_KEY and OPENROUTER_MODEL override these OpenRouter settings.
# Use an OpenRouter model ID supporting JSON output and images for receipts.
openrouter_api_key =
openrouter_model =
# These budgets only apply when AI_PROVIDER=groq.
requests_per_minute = 30
tokens_per_minute = 8000
tokens_per_day = 200000
# Input tokens per receipt image for qwen/qwen3.8-27b.
image_tokens = 2048
